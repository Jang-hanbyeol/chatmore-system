# ── 데이터베이스 (Prisma 7 + SQLite/libSQL 경량 데모 구성) ─────────
DATABASE_URL="file:./dev.db"

# ── 세션 서명 키 (32자 이상 무작위 문자열로 교체 필수) ─────────────
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── 관리자 계정 (시드 시 생성) ─────────────────────────────────────
ADMIN_EMAIL="admin@chatmore.kr"
ADMIN_NAME="Chatmore 관리자"
ADMIN_PASSWORD="chatmore1234!"

# ── 데모 학생 계정 공통 비밀번호 (시드 시 생성) ────────────────────
DEMO_USER_PASSWORD="chatmore-demo"

# ── 사이트 기본 정보 ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── (선택) 실제 AI 챗봇 / RAG API 연동 ────────────────────────────
# 값이 비어 있으면 Mock AI 서비스(데모 응답)로 동작합니다.
# 연동 규격은 README "AI·RAG 서버 연동 가이드" 참고.
CHATBOT_API_URL=""
CHATBOT_API_KEY=""
